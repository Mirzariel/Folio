---
/**
 * Claim: the preview is mandatory and it updates before you commit.
 * The pattern types itself and the rows rewrite live.
 * Extensions are preserved through every rename, RAW included.
 */
import Icon from '@/components/primitives/Icon.astro';
import { renameRows } from '@/data/mockup';
---

<div class="card job rv rv-d2" id="rename">
  <div class="job__intro">
  <div class="job__head">
    <div class="card__ico"><Icon name="rename" size={22} /></div>
    <span class="job__n">03</span>
  </div>
  <h3 class="h3">Rename in bulk</h3>
  <p>
    Give a whole set of photographs names you will still understand in ten years. Extensions
    are preserved, the preview is mandatory, and renaming happens in place.
  </p>
  </div>

  <div class="job__body">
  <div class="job__demo">
    <span class="klabel">Preview</span>
    <div class="rn__field">
    <span class="rn__label">Pattern</span>
    <span class="rn__text" id="rnText"></span>
    <i class="rn__caret" aria-hidden="true"></i>
  </div>
  <div class="rows" id="rnRows">
    {renameRows.map((row) => (
      <div class="rows__r">
        <span>{row.from}</span>
        <span class="rows__arw" aria-hidden="true">&rarr;</span>
        <b data-ext={row.ext} data-i={row.i}>{row.from}</b>
      </div>
    ))}
  </div>
  </div>
  <p class="tiny job__foot">
    If a name would collide, Folio says so and offers to keep both. It does not silently
    overwrite.
  </p>
  </div>
</div>

<style>
  .rn__field {
    display: flex; align-items: center; gap: 9px; height: 36px; padding: 0 11px; margin-top: 2px;
    border: 1px solid var(--border); border-radius: var(--r); background: var(--inset);
  }
  .rn__label {
    font-size: 10px; font-weight: 650; letter-spacing: .1em;
    text-transform: uppercase; color: var(--t3);
  }
  .rn__text { font-family: var(--mono); font-size: 12.5px; color: var(--t1); white-space: pre; }
  .rn__caret { width: 1.5px; height: 15px; background: var(--accent); animation: blink 1.05s steps(1) infinite; }
  .rn__caret.is-off { display: none; }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
</style>
