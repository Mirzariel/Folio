---
/**
 * Claim: quarantine frees nothing until you reclaim, and Folio says so.
 *
 * Four identical copies; three move into the quarantine folder and one stays.
 * The safe outcome is pre-selected, and the permanent one is never the default.
 * The quarantine figure reads "ready to reclaim, frees 0 B now" on purpose:
 * space saving must not be promised from candidate size alone.
 */
import Icon from '@/components/primitives/Icon.astro';
import { Image } from 'astro:assets';
import { site, display } from '@/config/site';
import copy from '@/assets/tiles/t01.jpg';
---

<div class="card job rv rv-d1" id="dupes">
  <div class="job__intro">
  <div class="job__head">
    <div class="card__ico"><Icon name="dupes" size={22} /></div>
    <span class="job__n">02</span>
  </div>
  <h3 class="h3">Find duplicates</h3>
  <p>
    Only byte-for-byte identical files are called duplicates. You choose which copy to keep,
    and what happens to the rest. The safe option is the one already selected.
  </p>
  </div>

  <div class="job__body">
  <div class="job__demo">
    <span class="klabel">Outcome</span>
    <div class="dupes__stage">
    <div class="dupes__fan">
      {[0, 1, 2, 3].map((i) => (
        <span class={`dupes__c${i === 3 ? ' dupes__c--keep' : ''}`} style={`--i:${i}`}>
          <Image
            src={copy}
            alt={i === 3 ? 'Four identical copies of the same photograph' : ''}
            width={440}
            height={440}
            loading="lazy"
          />
          {i === 3 && <span class="dupes__tag">Keep</span>}
        </span>
      ))}
    </div>
    <span class="dupes__dest" aria-hidden="true">
      <Icon name="folder" size={18} /><b class="dupes__destname">{site.canvas.quarantineFolder}</b>
    </span>
  </div>

    <div class="outc-set" role="radiogroup" aria-label="What happens to the other copies">
    <button type="button" class="outc is-on" role="radio" aria-checked="true" data-outcome="quarantine">
      <Icon name="check-c" size={16} />
      <span>
        <b>Quarantine safely</b>
        <span class="outc__b">
          Moved to a {site.canvas.quarantineFolder} folder on this drive, where you can put them back.
        </span>
        <i class="outc__f">{display.reclaimable} ready to reclaim &middot; frees 0 B now</i>
      </span>
    </button>
    <button type="button" class="outc outc--danger" role="radio" aria-checked="false" data-outcome="reclaim">
      <Icon name="circle" size={16} />
      <span>
        <b>Reclaim space</b>
        <span class="outc__b">Permanently removes the verified duplicate copies. No undo.</span>
        <i class="outc__f">Frees {display.reclaimable}</i>
      </span>
      </button>
    </div>
  </div>
  </div>
</div>

<style>
  .dupes__stage {
    position: relative; display: flex; align-items: center; gap: 10px;
    margin-top: 4px; min-height: 86px;
  }
  .dupes__fan { position: relative; width: 152px; height: 82px; flex: 0 0 152px; }
  .dupes__c {
    position: absolute; top: 4px; left: calc(var(--i) * 24px); width: 70px; height: 70px;
    border: 3px solid #F3ECE0; border-bottom-width: 9px; border-radius: 2px; overflow: hidden;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .3); z-index: calc(4 - var(--i));
    transform: rotate(calc((var(--i) - 1.5) * 3.5deg));
    transition: transform .75s var(--ease), opacity .55s var(--ease);
  }
  .dupes__c :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .dupes__tag {
    position: absolute; left: 0; right: 0; bottom: 0; text-align: center;
    font-size: 8px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #fff; background: rgba(0, 0, 0, .6); padding: 2px 0;
    opacity: 0; transition: opacity .4s var(--ease) .5s;
  }
  .dupes__stage.is-collapsed .dupes__tag { opacity: 1; }
  .dupes__stage.is-collapsed .dupes__c:not(.dupes__c--keep) {
    transform: translate(120px, 4px) rotate(0deg) scale(.28); opacity: 0;
    transition-delay: calc(var(--i) * .13s);
  }
  .dupes__stage.is-collapsed .dupes__c--keep { transform: rotate(0deg) translateX(-24px); }
  .dupes__dest {
    display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px;
    border: 1px dashed var(--border-2); border-radius: var(--r); color: var(--t2);
    font-size: 12px; transition: border-color .3s, color .3s;
  }
  .dupes__dest b { font-family: var(--mono); font-size: 11.5px; font-weight: 400; }
  .dupes__stage.is-danger .dupes__dest {
    border-color: var(--bad); color: var(--bad); border-style: solid;
  }

  .outc-set { display: grid; gap: 8px; margin-top: 4px; }
  .outc {
    display: flex; gap: 10px; padding: 10px 12px; border-radius: var(--r);
    border: 1px solid var(--border); text-align: left; width: 100%;
    transition: border-color .25s, background .25s;
  }
  .outc:hover { border-color: var(--border-2); }
  .outc.is-on { border-color: var(--accent); background: var(--accent-w); }
  .outc > :global(svg) { flex: 0 0 16px; margin-top: 3px; color: var(--t3); transition: color .25s; }
  .outc.is-on > :global(svg) { color: var(--accent-t); }
  .outc b { display: block; font-size: 13.5px; font-weight: 640; color: var(--t1); }
  .outc--danger b { color: var(--bad); }
  .outc__b { display: block; font-size: 12px; color: var(--t2); margin-top: 1px; line-height: 1.45; }
  .outc__f {
    display: block; font-style: normal; font-size: 11.5px; color: var(--t3);
    margin-top: 4px; font-variant-numeric: tabular-nums;
  }
</style>
