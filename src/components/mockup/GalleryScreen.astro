---
/**
 * The wall. Tiles carry the photograph and nothing else: names, paths, sizes
 * and dates belong to a photograph you have opened. A clip carries one small
 * badge, which is the only thing on a tile that is not the picture.
 *
 * Tiles are real buttons. Clicking one runs the connected enlargement from the
 * product spec: the tile grows into the viewer rather than navigating.
 *
 * So are the two segmented controls, because they look pressable and visitors
 * pressed them. Scale redraws the wall at three densities and the kind filter
 * shows photographs or clips. Behaviour is in src/scripts/interactions.ts, not
 * in the motion layer, so a motion preference can never leave them dead.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/primitives/Icon.astro';
import { tiles } from '@/data/gallery';
import { site, display } from '@/config/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/tiles/*.jpg', { eager: true });

const scales = [
  { id: 's', label: 'S' },
  { id: 'm', label: 'M' },
  { id: 'l', label: 'L' },
];
const kinds = [
  { id: 'all', label: 'All' },
  { id: 'photo', label: 'Photos' },
  { id: 'video', label: 'Videos' },
];
---

<div class="gal__bar">
  <div class="seg" role="radiogroup" aria-label="Tile scale" id="galScale">
    {scales.map((s) => (
      <button
        type="button"
        class={`seg__b${s.id === 'm' ? ' is-on' : ''}`}
        role="radio"
        aria-checked={s.id === 'm' ? 'true' : 'false'}
        tabindex={s.id === 'm' ? 0 : -1}
        data-scale={s.id}
      >{s.label}</button>
    ))}
  </div>

  <div class="seg" role="radiogroup" aria-label="Show" id="galKind">
    {kinds.map((k) => (
      <button
        type="button"
        class={`seg__b${k.id === 'all' ? ' is-on' : ''}`}
        role="radio"
        aria-checked={k.id === 'all' ? 'true' : 'false'}
        tabindex={k.id === 'all' ? 0 : -1}
        data-kind={k.id}
      >{k.label}</button>
    ))}
  </div>

  <span
    class="gal__meta"
    id="galMeta"
    data-month={site.canvas.galleryMonth}
    data-total={display.galleryItems}
  >{site.canvas.galleryMonth} &middot; {display.galleryItems}</span>
</div>

<div class="gal__grid" id="galgrid" data-scale="m">
  {tiles.map((tile, i) => (
    <button
      type="button"
      class={`gal__cell${tile.big ? ' gal__cell--big' : ''}`}
      style={`--n:${i}`}
      data-name={tile.name}
      data-kind={tile.clip ? 'video' : 'photo'}
      aria-label={`Open ${tile.name} in the viewer`}
    >
      <Image
        src={files[`../../assets/tiles/${tile.file}`]!.default}
        alt={tile.alt}
        width={440}
        height={440}
        loading="lazy"
      />
      {tile.clip && (
        <span class="gal__badge" aria-hidden="true"><Icon name="play" size={10} /></span>
      )}
    </button>
  ))}
  <span class="gal__sweep" aria-hidden="true"></span>
</div>

<style>
  .gal__bar {
    display: flex; align-items: center; gap: 10px; padding: 10px 16px; flex-wrap: wrap;
    border-bottom: 1px solid var(--border); background: var(--surface);
  }
  .seg { display: inline-flex; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
  .seg__b {
    padding: 5px 13px; font-size: 12.5px; color: var(--t2); cursor: pointer;
    border-right: 1px solid var(--border); transition: background .2s, color .2s;
  }
  .seg__b:last-child { border-right: 0; }
  .seg__b:hover { background: var(--accent-w); color: var(--accent-t); }
  .seg__b.is-on { background: var(--accent-w); color: var(--accent-t); font-weight: 640; }
  .gal__meta { margin-left: auto; font-size: 12px; color: var(--t3); }

  .gal__grid {
    position: relative; display: grid; --cols: 8;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: 1fr; grid-auto-flow: row dense; gap: 5px; padding: 12px; background: var(--bg);
  }
  /* S is a contact sheet, L is close reading. Enumerated rather than computed
     because repeat() will not take a calc(). */
  .gal__grid[data-scale="s"] { --cols: 12; }
  .gal__grid[data-scale="l"] { --cols: 5; }
  .gal__cell {
    position: relative; overflow: hidden; border-radius: 2px; display: block;
    cursor: zoom-in; aspect-ratio: 1;
  }
  .gal__cell.is-out { display: none; }
  .gal__cell :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .5s var(--ease);
  }
  .gal__cell:hover :global(img) { transform: scale(1.05); }
  .gal__cell--big { grid-column: span 2; grid-row: span 2; }
  .gal__badge {
    position: absolute; right: 5px; bottom: 5px; width: 19px; height: 19px; border-radius: 50%;
    background: rgba(0, 0, 0, .5); border: 1px solid rgba(255, 255, 255, .72); color: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .gal__sweep {
    position: absolute; top: 0; bottom: 0; left: 0; width: 20%; pointer-events: none;
    opacity: 0; z-index: 4;
    background: linear-gradient(90deg, transparent, rgba(224, 128, 58, .18) 42%, rgba(245, 234, 223, .34) 56%, transparent);
  }
  @container (max-width: 780px) {
    .gal__grid { --cols: 6; }
    .gal__grid[data-scale="s"] { --cols: 9; }
    .gal__grid[data-scale="l"] { --cols: 4; }
  }
  @container (max-width: 480px) {
    .gal__grid { --cols: 4; }
    .gal__grid[data-scale="s"] { --cols: 6; }
    .gal__grid[data-scale="l"] { --cols: 3; }
  }
</style>
