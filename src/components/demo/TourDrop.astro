---
/**
 * Step one of the live demo: a folder list and the three doors. Pictures can be
 * dragged onto any door (mouse, pen or touch) or simply pressed. The door it
 * lands on counts the scan. State classes are set by src/scripts/demos/tour.ts.
 */
import Icon from '@/components/primitives/Icon.astro';
import { doors } from '@/data/mockup';
import { pcFolders } from '@/data/tour';

const fmt = new Intl.NumberFormat('en-US');
---

<div class="td" id="tourDrop">
  <div class="td__pc">
    <div class="td__head"><Icon name="folder" size={15} />This PC</div>
    {pcFolders.map((folder) =>
      'live' in folder ? (
        <button type="button" class="td__row td__row--live" id="tourFolder" aria-describedby="tourHint">
          <Icon name="folder" size={16} /><span>{folder.name}</span><i>{fmt.format(folder.count)}</i>
        </button>
      ) : (
        <div class="td__row"><Icon name="folder" size={16} /><span>{folder.name}</span></div>
      ),
    )}
    <p class="td__hint" id="tourHint">Drag Pictures onto a panel, or press it.</p>
  </div>

  <div class="td__doors">
    {doors.map((door, i) => (
      <div class="td__door" data-door={i}>
        <span class="td__idx">{door.n}</span>
        <Icon name={door.icon} size={22} />
        <b>{door.title}</b>
        <div class="td__foot">
          <span class="td__drop">Release to scan</span>
          <div class="td__scan">
            <span class="td__lab">Scanning</span>
            <span class="td__n">0</span>
            <span class="td__bar"><i></i></span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="td__ghost" id="tourGhost" aria-hidden="true"><Icon name="folder" size={15} />Pictures</div>
  <svg class="td__cursor" id="tourCursor" viewBox="0 0 18 24" aria-hidden="true"><path d="M2 2v17l4.6-4.3 3 6.8 3-1.3-3-6.6H16z" /></svg>
</div>

<style>
  .td { position: relative; display: grid; grid-template-columns: minmax(170px, .5fr) 1fr; gap: clamp(12px, 2.4cqw, 26px); min-height: 300px; }
  .td__pc, .td__doors { border: 1px solid var(--border); background: var(--surface); border-radius: 6px; }
  .td__pc { align-self: center; overflow: hidden; }
  .td__head { display: flex; gap: 8px; align-items: center; height: 38px; padding: 0 14px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--t2); }
  .td__row { display: flex; align-items: center; gap: 10px; width: 100%; height: 42px; padding: 0 14px; color: var(--t2); font-size: 13px; text-align: left; }
  .td__row :global(svg) { color: var(--t3); flex: 0 0 16px; }
  .td__row i { margin-left: auto; font-style: normal; font-size: 11px; color: var(--t3); font-variant-numeric: tabular-nums; }
  .td__row--live { color: var(--t1); cursor: grab; touch-action: none; transition: background .2s; }
  .td__row--live :global(svg) { color: var(--accent-t); }
  .td__row--live:hover, .td__row--live.is-held { background: var(--accent-w); }
  .td__row--live.is-held { cursor: grabbing; }
  .td__hint { padding: 10px 14px 12px; font-size: 11.5px; color: var(--t3); border-top: 1px solid var(--border); }

  .td__doors { display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; }
  .td__door { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 16px; min-height: 250px; transition: background .2s, box-shadow .2s; }
  .td__door + .td__door { border-left: 1px solid var(--border); }
  .td__door:nth-child(1) { background: var(--raised); }
  .td__door > :global(svg) { margin-top: auto; color: var(--t2); }
  .td__door b { font-family: var(--serif); font-weight: 500; font-size: clamp(15px, 1.9cqw, 19px); line-height: 1.2; }
  .td__idx { font-size: 11px; color: var(--t3); font-variant-numeric: tabular-nums; }
  .td__door.is-over { background: var(--accent-w); box-shadow: inset 0 0 0 1px var(--accent); }
  .td__foot { position: relative; height: 58px; }
  .td__drop, .td__scan { position: absolute; inset: 0; opacity: 0; transition: opacity .18s; }
  .td__drop { display: flex; align-items: flex-end; font-size: 11.5px; color: var(--accent-t); padding-bottom: 4px; }
  .td__door.is-over .td__drop { opacity: 1; }
  .td__door.is-scanning .td__scan, .td__door.is-scanned .td__scan { opacity: 1; }
  .td__lab { display: block; font-size: 11px; color: var(--t3); }
  .td__n { display: block; font-size: 24px; font-weight: 620; font-variant-numeric: tabular-nums; line-height: 1.3; }
  .td__bar { display: block; height: 2px; background: var(--border); margin-top: 6px; overflow: hidden; }
  .td__bar i { display: block; height: 100%; width: 100%; background: var(--accent); transform: scaleX(var(--f, 0)); transform-origin: 0 50%; }
  .td__door.is-scanned .td__bar i { background: var(--good); }

  .td__ghost {
    position: absolute; left: 0; top: 0; z-index: 5; display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; background: var(--raised); border: 1px solid var(--border-2); border-radius: 6px;
    box-shadow: var(--shadow); font-size: 12px; white-space: nowrap; pointer-events: none; opacity: 0;
    transition: opacity .15s;
  }
  .td__ghost :global(svg) { color: var(--accent-t); }
  .td__ghost.is-on { opacity: 1; }
  .td__cursor { position: absolute; left: 0; top: 0; z-index: 6; width: 18px; height: 24px; pointer-events: none; opacity: 0; transition: opacity .2s; }
  .td__cursor.is-on { opacity: 1; }
  .td__cursor path { fill: #F5EADF; stroke: #0C0705; stroke-width: 1.4; stroke-linejoin: round; }

  @container (max-width: 640px) {
    .td { grid-template-columns: 1fr; }
    .td__doors { grid-template-columns: 1fr; }
    .td__door { min-height: 0; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 12px 14px; }
    .td__door + .td__door { border-left: 0; border-top: 1px solid var(--border); }
    .td__door > :global(svg) { margin-top: 0; order: -1; }
    .td__foot { flex: 1 0 100%; height: 50px; }
  }
</style>
