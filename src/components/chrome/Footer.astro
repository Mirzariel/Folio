---
import CopyEmail from '@/components/primitives/CopyEmail.astro';
import { footerColumns } from '@/data/navigation';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div>
        <a class="brand foot__brand" href="/#top">
          <img src="/folio-mark.png" alt="" width="30" height="30" />
          <span>Folio</span>
        </a>
        <p class="foot__blurb">
          A personal photo archive manager. {site.visionTagline}
        </p>
      </div>
      {footerColumns.map((col) => (
        <div>
          <h2 class="foot__h">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                {'copy' in link ? (
                  <><span class="vh">{link.label}: </span><CopyEmail email={link.copy} /></>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="foot__mark" aria-hidden="true">Folio</p>
    <div class="foot__bot">
      <span>&copy; {year} Folio. Made by one person, with care. <a href="#top" class="foot__top-link">Back to top &uarr;</a></span>
      <span>
        Photographs on this page are from
        <a href={site.unsplashUrl} rel="noopener" class="link">Unsplash</a>
        and stand in for your own.
      </span>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink-rail); color: var(--ink-t2);
    border-top: 1px solid var(--ink-border);
    padding: clamp(48px, 6vw, 72px) 0 34px; font-size: 14px;
  }
  .foot__top {
    display: grid; gap: 34px; padding-bottom: 34px;
    border-bottom: 1px solid var(--ink-border);
  }
  @media (min-width: 820px) { .foot__top { grid-template-columns: 1.7fr 1fr 1fr 1fr; } }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { width: 30px; height: 30px; border-radius: 7px; }
  .brand span {
    font-family: var(--serif); font-weight: 600; font-size: 19px;
    letter-spacing: -.01em; color: var(--ink-t1);
  }
  .foot__brand { margin: 0 0 14px; }
  .foot__blurb { max-width: 38ch; color: var(--ink-t3); font-size: var(--fs-small); line-height: var(--lh-body); }
  .foot__h {
    font-size: 11px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-t3); margin: 0 0 14px; font-family: var(--sans);
  }
  .foot li + li { margin-top: 9px; }
  .foot a:hover { color: var(--ink-t1); }
  /* The signature: the wordmark, very large and nearly not there, cut off by
     the bottom rule like a name embossed into the page. */
  .foot__mark {
    margin: clamp(24px, 4vw, 48px) 0 0; font-family: var(--serif); font-weight: 600;
    font-size: clamp(96px, 24vw, 340px); line-height: .8; letter-spacing: -.055em; text-align: center;
    background: linear-gradient(180deg, rgba(245, 234, 223, .09), rgba(245, 234, 223, 0) 85%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    user-select: none; height: .62em; overflow: hidden;
  }
  .foot__top-link { margin-left: 10px; color: var(--ink-t2); }
  .foot__top-link:hover { color: var(--ink-accent-t); }
  .foot a { transition: color .2s var(--ease); }
  .foot__bot {
    border-top: 1px solid var(--ink-border);
    padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 24px;
    justify-content: space-between; font-size: var(--fs-micro); color: var(--ink-t3);
  }
</style>
