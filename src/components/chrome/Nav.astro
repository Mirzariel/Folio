---
import { primaryNav } from '@/data/navigation';
import BuyButton from '@/components/primitives/BuyButton.astro';
import Icon from '@/components/primitives/Icon.astro';
---

<header class="nav" id="nav">
  <div class="nav__in">
    <a class="brand" href="/#top" aria-label="Folio, home">
      <img src="/folio-mark.png" alt="" width="30" height="30" />
      <span>Folio</span>
    </a>
    <nav class="nav__links" id="navlinks" aria-label="Primary">
      {primaryNav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="nav__cta">
      <BuyButton label="Get Folio" size="sm" />
      <button
        class="nav__burger"
        id="burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="navlinks"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <div class="nav__progress" id="progress" aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 60; height: var(--nav-h);
    display: flex; align-items: center;
    transition: background .3s var(--ease), border-color .3s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-stuck {
    background: rgba(5, 3, 2, .72);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    border-bottom-color: var(--ink-border);
  }
  .nav__in {
    width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gut);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px;
  }
  .nav__progress {
    position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    background: var(--ink-accent); transform: scaleX(0); transform-origin: 0 50%;
    opacity: 0; transition: opacity .3s;
  }
  .nav.is-stuck .nav__progress { opacity: .9; }
  .brand { display: flex; align-items: center; gap: 10px; justify-self: start; }
  .brand img { width: 30px; height: 30px; border-radius: 7px; }
  .brand span {
    font-family: var(--serif); font-weight: 600; font-size: 19px;
    letter-spacing: -.01em; color: var(--ink-t1);
  }
  .nav__links { display: flex; gap: 2px; }
  .nav__links a {
    position: relative; padding: 8px 14px; border-radius: 999px; font-size: var(--fs-small); font-weight: 500;
    color: var(--ink-t2); transition: color .16s, background .16s;
  }
  .nav__links a:hover { color: var(--ink-t1); background: rgba(245, 234, 223, .06); }
  .nav__links a.is-here { color: var(--ink-accent-t); }
  .nav__links a.is-here::after {
    content: ""; position: absolute; left: 13px; right: 13px; bottom: 3px; height: 1px;
    background: var(--ink-accent);
  }
  .nav__cta { display: flex; align-items: center; gap: 12px; justify-self: end; }
  .nav__burger {
    display: none; width: 42px; height: 42px; align-items: center; justify-content: center;
    border: 1px solid var(--ink-border-2); border-radius: var(--r); color: var(--ink-t1);
  }
  @media (max-width: 1000px) {
    /* The links leave the grid, so the actions take the second column. */
    .nav__in { grid-template-columns: 1fr auto; }
    .nav__links { display: none; }
    .nav__burger { display: flex; }
    .nav__cta :global(.btn) { display: none; }
    .nav.is-open { background: rgba(12, 7, 5, .98); }
    .nav__links.is-open {
      display: flex; flex-direction: column; position: absolute; top: var(--nav-h); left: 0; right: 0;
      background: var(--ink-rail); border-bottom: 1px solid var(--ink-border);
      padding: 8px var(--gut) 22px; gap: 0;
    }
    .nav__links.is-open a {
      padding: 14px 4px; font-size: 16px;
      border-bottom: 1px solid var(--ink-border); border-radius: 0;
    }
  }
</style>
