---
/** Sticky mobile buy bar. Hides itself while the pricing section is on screen. */
import { display } from '@/config/site';
import BuyButton from '@/components/primitives/BuyButton.astro';
---

<div class="buybar" id="buybar">
  <div class="buybar__t">
    <b>Folio, {display.price}</b>one-time, no subscription
  </div>
  <BuyButton label="Get it" size="sm" />
</div>

<style>
  .buybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 55; display: none;
    align-items: center; gap: 12px;
    padding: 11px var(--gut) calc(11px + env(safe-area-inset-bottom));
    background: rgba(20, 12, 8, .97);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-top: 1px solid var(--ink-border);
    transform: translateY(110%); transition: transform .32s var(--ease);
  }
  .buybar.is-on { transform: none; }
  .buybar__t { font-size: var(--fs-micro); color: var(--ink-t3); line-height: 1.3; }
  .buybar__t b { display: block; color: var(--ink-t1); font-size: var(--fs-body); font-weight: 640; }
  .buybar :global(.btn) { margin-left: auto; }
  @media (max-width: 720px) { .buybar { display: flex; } }
</style>
