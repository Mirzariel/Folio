---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Icon from '@/components/primitives/Icon.astro';
import DuplicateCard from '@/components/mockup/DuplicateCard.astro';
import RenameCard from '@/components/mockup/RenameCard.astro';
import { arrangeRows } from '@/data/mockup';
---

<section class="sect t-paper" id="jobs">
  <div class="wrap">
    <div class="head rv">
      <Eyebrow>What it does</Eyebrow>
      <h2 class="h2">Three jobs. Each writes the plan out first.</h2>
      <p class="lede">
        Not forty utilities sharing a window. A few things, done where you can watch.
      </p>
      <p class="cue jobs__cue">
        Live panels<span class="cue__hint">the framed area in each card runs its own job</span>
      </p>
    </div>

    <div class="grid g-3 jobs__grid">
      <div class="card job rv">
        <div class="job__intro">
        <div class="job__head">
          <div class="card__ico"><Icon name="calendar" size={22} /></div>
          <span class="job__n">01</span>
        </div>
        <h3 class="h3">Organize by date</h3>
        <p>
          Year and month folders, by the date the photo was taken. Not the date Windows
          stamped on the file.
        </p>
        </div>

        <div class="job__body">
        <div class="job__demo">
          <span class="klabel">Plan</span>
          <div class="rows">
            {arrangeRows.map((row) => (
              <div class="rows__r">
                <span>{row.from}</span>
                <span class="rows__arw" aria-hidden="true">&rarr;</span>
                <b>{row.to}</b>
              </div>
            ))}
          </div>
        </div>
        <p class="tiny job__foot">
          Stays inside the source you chose.
        </p>
        </div>
      </div>

      <DuplicateCard />
      <RenameCard />
    </div>
  </div>
</section>

<style>
  .jobs__cue { margin-top: 20px; margin-bottom: 0; }
  .jobs__grid { margin-top: clamp(30px, 3.6vw, 46px); }
</style>
