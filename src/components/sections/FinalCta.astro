---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import SplitHeading from '@/components/primitives/SplitHeading.astro';
import BuyButton from '@/components/primitives/BuyButton.astro';
import TrustList from '@/components/primitives/TrustList.astro';

const closing = [
  { label: 'Windows today', icon: 'windows' },
  { label: 'macOS included when it ships', icon: 'apple' },
  { label: 'Pay once, no subscription' },
];
---

<section class="sect t-dark" id="get">
  <div class="wrap wrap--narrow center">
    <div class="rv">
      <Eyebrow center>Get Folio</Eyebrow>
      <SplitHeading
        lines={['You already took the photographs.', 'Let Folio do the rest.']}
        class="get__title"
      />
      <p class="lede get__lede">
        One payment, for the afternoon you finally stop dreading. And for every time after
        it, when you want to know exactly what you have.
      </p>
      <div class="cta-row get__cta">
        <BuyButton label="Get Folio" />
      </div>
      <TrustList items={closing} variant="center" />
    </div>
  </div>
</section>

<style>
  .get__title { margin-top: 18px; }
  .get__lede { margin-top: 22px; }
  .get__cta { margin-top: 34px; }
  .get__cta :global(.btn) { min-width: min(320px, 100%); }
</style>
