---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import { faqEntries } from '@/data/faq';
---

<section class="sect t-paper" id="faq">
  <div class="wrap wrap--narrow">
    <div class="head rv faq__head">
      <Eyebrow>Questions</Eyebrow>
      <h2 class="h2">Worth asking before you trust software with your memories.</h2>
    </div>

    <div class="faq rv">
      {faqEntries.map((entry, i) => (
        <details open={i === 0}>
          <summary>{entry.question}</summary>
          <div class="faq__a">
            {entry.answer.map((para) => <p set:html={para} />)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__head { margin-bottom: clamp(28px, 3.4vw, 44px); }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary {
    list-style: none; cursor: pointer; padding: 22px 46px 22px 0; position: relative;
    font-family: var(--serif); font-weight: 600; font-size: clamp(17px, 1.6vw, 20px);
    letter-spacing: -.008em; color: var(--t1); text-wrap: balance;
    transition: color .2s;
  }
  .faq summary:hover { color: var(--accent-t); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: ""; position: absolute; right: 8px; top: 50%; width: 12px; height: 12px;
    margin-top: -8px; border-right: 2px solid var(--accent-t);
    border-bottom: 2px solid var(--accent-t);
    transform: rotate(45deg); transition: transform .25s var(--ease), margin-top .25s var(--ease);
  }
  .faq details[open] summary::after { transform: rotate(-135deg); margin-top: -2px; }
  .faq__a { padding: 0 46px 24px 0; color: var(--t2); font-size: var(--fs-body); line-height: var(--lh-body); max-width: 68ch; }
  .faq details[open] .faq__a { animation: faqIn .4s var(--ease) both; }
  @keyframes faqIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .faq__a p + p { margin-top: 12px; }
  .faq__a :global(b) { color: var(--t1); font-weight: 620; }
</style>
