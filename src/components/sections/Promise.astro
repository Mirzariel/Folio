---
/**
 * The one heading that does NOT follow the "You X. Folio Y." motif, because
 * "Understand before you move. Verify before you remove." is FOLIO_VISION.md
 * section 6's own line and outranks the pattern. Do not rewrite it.
 */
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import SplitHeading from '@/components/primitives/SplitHeading.astro';
import Window from '@/components/mockup/Window.astro';
import PlanScreen from '@/components/mockup/PlanScreen.astro';
---

<section class="sect t-dark" id="promise">
  <div class="wrap">
    <div class="head head--center rv promise__head">
      <Eyebrow center>The promise</Eyebrow>
      <SplitHeading
        lines={['Understand before you move.', 'Verify before you remove.']}
      />
      <p class="lede">
        Every other tool in this category asks you to trust it. Folio asks you to
        <em>check</em> it. The plan is written out in full, real filenames and real
        destinations, before a single byte moves. Watch it run.
      </p>
    </div>

    <div class="promise__sticky">
      <Window name="Organize by date" back id="planwin" status="Waiting for you" statusId="planStatus">
        <PlanScreen />
      </Window>
    </div>

    <p class="lede rv promise__coda">
      <strong>&ldquo;Changes require approval&rdquo; sits in the status bar permanently</strong>,
      not as a warning that appears the moment something is about to happen. A promise you
      only see when you are already in danger is a warning, and people learn to click past
      warnings.
    </p>
  </div>
</section>

<style>
  .promise__head { margin-bottom: clamp(34px, 4.4vw, 54px); }
  /* Deliberately not sticky. The window is taller than the room above the
     fold, so pinning it scrolled its status strip out of view and left it
     there. The coda below claims that strip is permanently visible, so the
     layout has to keep that true. */
  .promise__sticky { position: static; }
  .promise__coda { margin: clamp(30px, 3.6vw, 46px) auto 0; text-align: center; max-width: 70ch; }
  .promise__coda strong { color: var(--t1); font-weight: 600; }
</style>
