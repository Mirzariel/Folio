---
/**
 * Every figure here comes from src/config/site.ts. The two binding promises
 * (macOS at no extra cost, and the device count) are commitments to every
 * buyer: see docs/LAUNCH_CHECKLIST.md before changing either.
 */
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Icon from '@/components/primitives/Icon.astro';
import BuyButton from '@/components/primitives/BuyButton.astro';
import CopyEmail from '@/components/primitives/CopyEmail.astro';
import { site, display } from '@/config/site';

/* One column, short. A list that restates what is two inches above it stops
   being read. */
const included = [
  `<b>Folio for ${site.platforms.shipping.join(' and ')}</b> (64-bit)`,
  '<b>Folio for macOS when it ships</b>, at no extra cost',
  `<b>${site.license.devices} activations</b>, one per Windows account you use it in`,
  '<b>Every future update, free for life</b>, major versions included',
  '<b>Unlimited photos and drives.</b> No per-gigabyte limits',
  '<b>Works offline</b> after a one-time activation',
];
---

<section class="sect t-dark" id="pricing">
  <div class="wrap wrap--narrow">
    <div class="head head--center rv pricing__head">
      <Eyebrow center>Pricing</Eyebrow>
      <h2 class="h2">One price. One payment. Yours.</h2>
      <p class="lede">
        Less than a year of even the cheapest cloud photo plan, paid once instead of forever.
      </p>
    </div>

    <div class="price rv">
      <div class="price__top">
        <span class="price__badge">{display.offer ? 'Launch price' : 'One-time purchase'}</span>
        <div class="price__tag">
          {display.offer && <s class="price__was" aria-label={`Regular price ${display.regularPrice}`}>{display.regularPrice}</s>}
          <span class="price__cur">$</span>
          <span class="price__amt">{display.amount}</span>
        </div>
        {display.offerNote && <p class="price__offer">{display.offerNote}</p>}
        <p class="price__per">
          {display.priceCurrency} Not per month. Not per year. Not per photo.
        </p>
        <div class="price__plat" aria-hidden="true">
          <span><Icon name="windows" size={15} />Windows</span>
          <span><Icon name="apple" size={15} />macOS</span>
        </div>
        <BuyButton label="Get Folio" />
        <p class="price__strike">
          Secure checkout &middot; instant license key
        </p>
      </div>

      <ul class="price__list">
        {included.map((item) => (
          <li><Icon name="check-c" size={17} /><span set:html={item} /></li>
        ))}
      </ul>

      <p class="price__foot">
        {site.platforms.shipping.join(' or ')}, 64-bit, is what ships today. Folio for macOS
        and connected-device transfer are in development with no release date. Your license
        already covers macOS, so you will not be asked to pay again. Price is in US dollars.
      </p>
    </div>

    <p class="small center rv pricing__team">
      Team, studio, or a family sharing one archive? Write to
      <CopyEmail email={site.support.email} />
    </p>
  </div>
</section>

<style>
  .pricing__head { margin-bottom: clamp(32px, 4vw, 48px); }
  .price {
    border: 1px solid var(--border-2); border-radius: var(--r-lg); background: var(--raised);
    overflow: hidden; box-shadow: var(--shadow);
  }
  .price__top {
    padding: clamp(30px, 3.6vw, 46px); display: grid; gap: 18px;
    text-align: center; justify-items: center;
  }
  .price__tag { display: flex; align-items: baseline; justify-content: center; gap: 8px; }
  .price__amt {
    font-family: var(--serif); font-weight: 600; font-size: clamp(64px, 9vw, 106px);
    line-height: .88; letter-spacing: -.035em; color: var(--t1);
  }
  .price__cur {
    font-family: var(--serif); font-size: clamp(26px, 3vw, 38px); color: var(--t2);
    align-self: flex-start; margin-top: .12em;
  }
  .price__per { font-size: var(--fs-body); color: var(--t2); }
  .price__was {
    font-family: var(--serif); font-size: clamp(24px, 2.8vw, 34px); color: var(--t3);
    align-self: center; margin-right: 10px; text-decoration-thickness: 2px;
  }
  .price__offer { font-size: var(--fs-small); font-weight: 620; color: var(--accent-t); margin-top: -8px; }
  .price__plat { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .price__plat span {
    display: inline-flex; align-items: center; gap: 7px; padding: 5px 13px;
    border: 1px solid var(--border); border-radius: 999px; font-size: var(--fs-micro); color: var(--t2);
  }
  .price__plat :global(svg) { color: var(--t1); }
  .price__top :global(.btn) { min-width: min(340px, 100%); }
  .price__strike { color: var(--t3); font-size: var(--fs-small); }
  /* One centred column. Two columns worked at eight items and went ragged at
     five, with a hole where the sixth used to be. A single column also reads
     as a list rather than as a table of specifications. */
  .price__list {
    border-top: 1px solid var(--border); padding: clamp(26px, 3vw, 36px);
    display: grid; grid-template-columns: minmax(0, 48ch); justify-content: center;
    gap: 15px; background: var(--surface);
  }
  .price__list li {
    display: flex; gap: 11px; font-size: var(--fs-body); color: var(--t2);
    align-items: flex-start; line-height: var(--lh-body); text-wrap: pretty;
  }
  .price__list :global(svg) { flex: 0 0 17px; color: var(--good); margin-top: 3px; }
  .price__list :global(b) { color: var(--t1); font-weight: 620; }
  .price__foot {
    border-top: 1px solid var(--border); padding: 16px clamp(24px, 3vw, 34px);
    font-size: var(--fs-micro); color: var(--t3); background: var(--inset); text-wrap: pretty;
  }
  .price__badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px;
    border: 1px solid var(--accent); background: var(--accent-w); color: var(--accent-t);
    font-size: 11.5px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase;
  }
  .pricing__team { margin-top: 26px; }
</style>
