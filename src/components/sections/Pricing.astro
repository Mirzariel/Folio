---
/**
 * Every figure here comes from src/config/site.ts. The two binding promises
 * (macOS at no extra cost, and the device count) are commitments to every
 * buyer: see docs/LAUNCH_CHECKLIST.md before changing either.
 */
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import SplitHeading from '@/components/primitives/SplitHeading.astro';
import Icon from '@/components/primitives/Icon.astro';
import OfferCard from '@/components/pricing/OfferCard.astro';
import CopyEmail from '@/components/primitives/CopyEmail.astro';
import { site, display } from '@/config/site';

/* One column, short. A list that restates what is two inches above it stops
   being read. */
const included = [
  `<b>Folio for ${site.platforms.shipping.join(' and ')}</b> (64-bit)`,
  '<b>Folio for macOS when it ships</b>, at no extra cost',
  `<b>${site.license.devices} activations</b>, one per Windows account you use it in`,
  '<b>Every future update, free for life</b>, major versions included',
  '<b>Unlimited photos and drives.</b> No per-gigabyte limits',
  '<b>Works offline</b> after a one-time activation',
];
---

<section class="sect t-void" id="pricing">
  <div class="wrap wrap--narrow">
    <div class="head head--center rv pricing__head">
      <Eyebrow center>{display.offer ? 'Launch week' : 'Pricing'}</Eyebrow>
      <SplitHeading lines={['You pay once.', 'Folio is yours for good.']} />
      <p class="lede">
        Less than a year of even the cheapest cloud photo plan, paid once instead of forever.
      </p>
    </div>

    <div class="price rv">
      <OfferCard />

      <ul class="price__list">
        {included.map((item) => (
          <li><Icon name="check-c" size={17} /><span set:html={item} /></li>
        ))}
      </ul>

      <p class="price__foot">
        {site.platforms.shipping.join(' or ')}, 64-bit, is what ships today.
        {site.platforms.untested.join(' and ')} is built for but not yet tested: if Folio does not
        run on it, the 14-day refund covers you. Folio for macOS
        and connected-device transfer are in development with no release date. Your license
        already covers macOS, so you will not be asked to pay again. Price is in US dollars.
      </p>
    </div>

    <p class="small center rv pricing__team">
      Team, studio, or a family sharing one archive? Write to
      <CopyEmail email={site.support.email} />
    </p>
  </div>
</section>

<style>
  .pricing__head { margin-bottom: clamp(32px, 4vw, 48px); }
  /* The card glows along its edge: a slow conic sweep behind a 1px gap. */
  .price {
    position: relative; border-radius: 18px; background: var(--raised); box-shadow: var(--shadow);
    isolation: isolate;
  }
  .price::before {
    content: ""; position: absolute; inset: -1.5px; z-index: -1; border-radius: 19.5px;
    background: conic-gradient(from var(--spin, 0deg), var(--accent), transparent 30%, transparent 60%, var(--accent-t), var(--accent));
    animation: spin 6s linear infinite;
  }
  .price::after {
    content: ""; position: absolute; inset: -40px; z-index: -2; border-radius: 40px;
    background: radial-gradient(60% 50% at 50% 30%, rgba(224, 128, 58, .22), transparent 70%);
  }
  .price :global(.oc) { overflow: hidden; border-radius: 18px 18px 0 0; background: var(--raised); }
  @property --spin { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --spin: 360deg; } }
  /* One centred column. Two columns worked at eight items and went ragged at
     five, with a hole where the sixth used to be. A single column also reads
     as a list rather than as a table of specifications. */
  .price__list {
    border-top: 1px solid var(--border); padding: clamp(26px, 3vw, 36px);
    display: grid; grid-template-columns: minmax(0, 48ch); justify-content: center;
    gap: 15px; background: var(--surface);
  }
  .price__list li {
    display: flex; gap: 11px; font-size: var(--fs-body); color: var(--t2);
    align-items: flex-start; line-height: var(--lh-body); text-wrap: pretty;
  }
  .price__list :global(svg) { flex: 0 0 17px; color: var(--good); margin-top: 3px; }
  .price__list :global(b) { color: var(--t1); font-weight: 620; }
  .price__foot {
    border-radius: 0 0 18px 18px; border-top: 1px solid var(--border); padding: 16px clamp(24px, 3vw, 34px);
    font-size: var(--fs-micro); color: var(--t3); background: var(--inset); text-wrap: pretty;
  }
  .pricing__team { margin-top: 26px; }
</style>
