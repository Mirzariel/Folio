---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import SplitHeading from '@/components/primitives/SplitHeading.astro';
import Window from '@/components/mockup/Window.astro';
import GalleryScreen from '@/components/mockup/GalleryScreen.astro';

const notes = [
  {
    title: 'Scale is a control, not a setting',
    body: 'S, M, L: contact sheet, normal, close reading. The main decision on this page, so it is not buried in a menu.',
  },
  {
    title: 'The viewer covers the wall',
    body: 'Opening a photograph does not navigate away. Escape reads as putting a print back down.',
  },
  {
    title: 'Video and photo, told apart',
    body: 'A clip is indistinguishable from a still frame, so it carries one small badge. Nothing else sits on a tile.',
  },
];
---

<section class="sect t-dark" id="gallery">
  <div class="wrap">
    <div class="head rv gallery__head">
      <Eyebrow>The gallery</Eyebrow>
      <SplitHeading lines={['You see photographs.', 'Folio handles the filenames.']} />
      <p class="lede">
        Tiles carry the photograph and nothing else. Names, paths, sizes and dates belong to
        a photograph you have <em>opened</em>.
      </p>
    </div>

    <Window
      name="Gallery"
      back
      status="Scale: M · Sorted by capture date"
      statusId="galStatus"
      tilt
      cue="Try it"
      cueHint="the controls work. Click a photograph, then press Escape."
    >
      <GalleryScreen />
    </Window>

    <div class="grid g-3 gallery__notes">
      {notes.map((note, i) => (
        <div class={`rv${i > 0 ? ` rv-d${i}` : ''}`}>
          <h3 class="h4">{note.title}</h3>
          <p class="small">{note.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery__head { margin-bottom: clamp(32px, 4vw, 52px); }
  .gallery__notes { margin-top: clamp(32px, 4vw, 48px); }
  .gallery__notes .small { margin-top: 6px; }
</style>
