---
/**
 * An email address as a mailto: link, with a Copy button beside it. The link
 * opens the system mail app; the button serves visitors who use webmail
 * instead. See src/scripts/copyEmail.ts, which builds the same markup for
 * addresses added at runtime: change both together.
 *
 * Kept on one line so no stray whitespace lands between the parts. Without
 * scripting the button is hidden and the link still works.
 */
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<span class="copy-email"><a class="copy-email__addr" href={`mailto:${email}`}>{email}</a><button type="button" class="copy-email__btn" data-copy={email}><span class="copy-email__label">Copy</span><span class="vh"> email address</span></button></span>
