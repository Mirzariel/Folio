---
/**
 * Inlines an SVG from src/icons/ at build time.
 *
 * Replaces the 22-symbol <svg><symbol> sprite that used to sit hard-coded at
 * the top of index.html. Only icons a page actually renders are emitted, and
 * each icon is one reviewable file. No runtime dependency.
 *
 * Icons are decorative by default. Pass `label` only when the icon is the sole
 * carrier of meaning; if adjacent text already says it, leave it hidden.
 */
interface Props {
  /** Filename in src/icons/, without the extension. */
  name: string;
  size?: number;
  /** Accessible name. Omit for decorative icons. */
  label?: string;
  class?: string;
}

const { name, size = 16, label, class: className } = Astro.props;

const files = import.meta.glob<string>('../../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const raw = files[`../../icons/${name}.svg`];
if (!raw) {
  const available = Object.keys(files)
    .map((p) => p.split('/').pop()?.replace('.svg', ''))
    .join(', ');
  throw new Error(`Icon "${name}" not found in src/icons/. Available: ${available}`);
}

// Keep the source viewBox and stroke/fill presentation; impose our own size.
const openTag = /^<svg([^>]*)>/.exec(raw)?.[1] ?? '';
const attrs = openTag
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/\sxmlns="[^"]*"/g, '')
  .trim();
const inner = raw.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();

const a11y = label
  ? `role="img" aria-label="${label.replace(/"/g, '&quot;')}"`
  : 'aria-hidden="true" focusable="false"';
const cls = className ? ` class="${className}"` : '';

const svg = `<svg ${attrs} width="${size}" height="${size}" ${a11y}${cls}>${inner}</svg>`;
---

<Fragment set:html={svg} />
