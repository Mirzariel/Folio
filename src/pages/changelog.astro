---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';

/* Upcoming entries come first; released ones follow, newest first. */
const time = (d?: Date) => d?.getTime() ?? Number.POSITIVE_INFINITY;
const entries = (await getCollection('changelog')).sort(
  (a, b) => time(b.data.date) - time(a.data.date),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Changelog · Folio"
  description="What changed in each release of Folio, and what did not."
  showBuyBar={false}
>
  <section class="sect t-paper log__sect">
    <div class="wrap wrap--narrow">
      <Eyebrow>Changelog</Eyebrow>
      <h1 class="h2 log__title">What changed, and what did not.</h1>

      {rendered.map(({ entry, Content }) => (
        <article class="log__entry">
          <header class="log__head">
            <h2 class="h3">{entry.data.version}</h2>
            <span class="card__tag">{entry.data.platform}</span>
            {entry.data.status === 'upcoming' || !entry.data.date ? (
              <span class="small">Not released yet</span>
            ) : (
              <time class="small" datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('en-US', {
                  year: 'numeric', month: 'long', day: 'numeric',
                })}
              </time>
            )}
          </header>
          <p class="lede log__summary">{entry.data.summary}</p>
          <div class="prose"><Content /></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .log__sect { padding-top: clamp(120px, 12vw, 170px); }
  .log__title { margin-top: 16px; }
  .log__entry { padding-top: clamp(34px, 4vw, 48px); margin-top: clamp(34px, 4vw, 48px); border-top: 1px solid var(--border); }
  .log__head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .log__summary { margin-top: 12px; }
  .prose { margin-top: 18px; color: var(--t2); font-size: 15.5px; }
  .prose :global(h2) { font-size: 15px; font-weight: 640; color: var(--t1); margin: 22px 0 10px; }
  .prose :global(ul) { margin: 0 0 14px; padding-left: 20px; list-style: disc; }
  .prose :global(li) { margin-bottom: 6px; line-height: 1.6; }
  .prose :global(p) { margin-bottom: 12px; line-height: 1.65; }
  .prose :global(code) { background: var(--inset); padding: 1px 5px; border-radius: 3px; }
</style>
