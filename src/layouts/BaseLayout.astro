---
/**
 * The shell every page shares: head, nav, footer and the sticky mobile buy bar.
 *
 * og:image must be an absolute URL or most social networks will not resolve it.
 * It becomes absolute automatically once `site` is set in astro.config.mjs;
 * npm run check:copy fails the build if it is still relative at that point.
 */
import Nav from '@/components/chrome/Nav.astro';
import Footer from '@/components/chrome/Footer.astro';
import BuyBar from '@/components/chrome/BuyBar.astro';
import Analytics from '@vercel/analytics/astro';
import { site, display } from '@/config/site';
import { faqPageSchema } from '@/data/faq';

/* Self-hosted, so a page load contacts no third party. The privacy page says
   so, and check-copy.mjs fails if a Google Fonts URL comes back. */
import '@fontsource/spectral/500.css';
import '@fontsource/spectral/600.css';
import '@fontsource-variable/inter';

import '@/styles/tokens.css';
import '@/styles/reset.css';
import '@/styles/base.css';
import '@/styles/components.css';
import '@/styles/mockup.css';
import '@/styles/reduced-motion.css';

interface Props {
  title: string;
  description?: string;
  /** Suppresses the sticky buy bar on pages that are not selling. */
  showBuyBar?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  /** Emits SoftwareApplication JSON-LD. Only the home page describes the product. */
  productSchema?: boolean;
  /** Emits FAQPage JSON-LD. Only the page that actually shows the FAQ. */
  faqSchema?: boolean;
}

const {
  title,
  description = site.description,
  showBuyBar = true,
  ogTitle = 'Folio, a personal photo archive manager',
  ogDescription = 'Folio organizes the scattered photos on your PC. It shows you the whole plan first, and nothing changes until you approve it.',
  productSchema = false,
  faqSchema = false,
} = Astro.props;

/* Every value comes from site.ts, so the structured data cannot drift from the
   page. No rating or review is included: there are no real ones yet. */
const productJsonLd = productSchema && Astro.site ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  url: Astro.site.href,
  image: new URL('/og-card.png', Astro.site).href,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: site.platforms.shipping.join(', '),
  offers: {
    '@type': 'Offer',
    price: String(display.amount),
    priceCurrency: site.price.currency,
    availability: 'https://schema.org/InStock',
    url: site.checkoutUrl,
  },
} : null;

/* Bump the version when public/og-card.png changes: X and others cache the card by URL. */
const ogPath = '/og-card.png?v=2';
const ogImage = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" class="t-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0705" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/folio-mark.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/folio-icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/folio-icon-192.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.tagline} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {productJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />}
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageSchema())} />}

    <!-- Vercel Web Analytics: cookieless page views. Served from this site's own
         /_vercel path, so it adds no third-party request. privacy.md says so. -->
    <Analytics />

    <!-- Gates every reveal. Without scripting the page is static and complete. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    {display.offer && (
      /* The offer ends on the visitor's clock too, not only at the next build. */
      <script is:inline define:vars={{ endsAt: display.offer.endsAt }}>
        if (Date.now() >= Date.parse(endsAt)) {
          document.documentElement.classList.add('offer-ended');
          addEventListener('DOMContentLoaded', () => document.querySelectorAll('[data-checkout-regular]')
            .forEach((a) => a.setAttribute('href', a.getAttribute('data-checkout-regular'))));
        }
      </script>
    )}
  </head>

  <body>
    <Nav />
    <main id="top">
      <slot />
    </main>
    <Footer />
    {showBuyBar && <BuyBar />}

    <script>
      import "@/scripts/main";
    </script>
  </body>
</html>
